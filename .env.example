# Public origin used for canonical URLs, Open Graph tags, robots.txt, and sitemap.xml.
# Vercel sets VERCEL_URL automatically. Set this only when using a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional: replace the placeholders in the Hire / Fiverr panels.
NEXT_PUBLIC_FIVERR_URL=
NEXT_PUBLIC_CALENDLY_URL=